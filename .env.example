# Copy this file to .env and replace every placeholder locally.
# Never commit .env or send real passwords/tokens in chat.

# MT5 terminal credentials (paper trading does not require these)
MT5_LOGIN=12345678
MT5_PASSWORD=replace-with-your-demo-password
MT5_SERVER=YourBroker-Demo

# OANDA practice credentials
OANDA_ACCOUNT_ID=101-xxx-xxxxxxxx-001
OANDA_API_TOKEN=replace-with-your-practice-token
OANDA_ENVIRONMENT=practice

# TimescaleDB; Compose reads these same DB_* values
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tradingbot
DB_USER=postgres
DB_PASSWORD=replace-with-a-strong-local-password

# FastAPI login and JWT signing secret
API_USERNAME=replace-with-a-local-username
API_PASSWORD=replace-with-a-strong-local-password
JWT_SECRET_KEY=replace-with-a-random-64-character-hex-secret
JWT_ALGORITHM=HS256